<% content_for :title, "#{@article.title} - Base de Conocimiento" %>

<div class="page-header">
  <div>
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
      <span class="badge badge-primary">
        <%= @article.ticket_category&.name || "General" %>
      </span>
      <span style="font-size: 0.8rem; color: var(--slate-500);">
        👁️ <%= @article.views_count %> lecturas • Publicado por <strong><%= @article.user.full_name %></strong>
      </span>
    </div>
    <h1 class="page-title"><%= @article.title %></h1>
  </div>

  <div style="display: flex; gap: 0.5rem;">
    <% if current_user.staff? %>
      <%= link_to "✏️ Editar", edit_kb_article_path(@article), class: "btn btn-secondary btn-sm" %>
      <% if current_user.admin? %>
        <%= button_to kb_article_path(@article), method: :delete, data: { turbo_confirm: "¿Eliminar este artículo?" }, class: "btn btn-danger btn-sm" do %>
          <span>🗑️ Eliminar</span>
        <% end %>
      <% end %>
    <% end %>
    <%= link_to "← Volver a Artículos", kb_articles_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div class="card">
  <div class="card-body" style="padding: 2.5rem; max-width: 860px; margin: 0 auto;">
    <div style="font-size: 1rem; line-height: 1.8; color: var(--slate-800); white-space: pre-wrap;">
      <%= @article.content %>
    </div>
  </div>
</div>
