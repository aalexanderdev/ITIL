<% content_for :title, "Perfiles y Permisos - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Perfiles y Permisos (RBAC)</h1>
    <p class="page-subtitle">Configuración de perfiles de usuario y matrices de permisos sobre tickets, inventario, chat y administración</p>
  </div>
  <div>
    <%= link_to new_profile_path, class: "btn btn-primary" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Nuevo Perfil</span>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Perfil</th>
          <th>Rol Base</th>
          <th>Descripción</th>
          <th>Usuarios</th>
          <th>Permisos Activos</th>
          <th>Por Defecto</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @profiles.each do |profile| %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: <%= profile.color %>; flex-shrink: 0;"></span>
                <span style="font-weight: 600; color: var(--slate-900);"><%= profile.name %></span>
              </div>
            </td>
            <td>
              <span class="badge <%= profile.base_role == 'admin' ? 'badge-primary' : (profile.base_role == 'technician' ? 'badge-info' : 'badge-secondary') %>">
                <%= profile.base_role.titleize %>
              </span>
            </td>
            <td>
              <span style="color: var(--slate-600); font-size: 0.85rem;"><%= profile.description.presence || "—" %></span>
            </td>
            <td>
              <span class="badge badge-light" style="font-weight: 600;">
                <%= profile.users.size %> usuario(s)
              </span>
            </td>
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <div style="width: 80px; height: 8px; background: var(--slate-200); border-radius: 4px; overflow: hidden;">
                  <div style="width: <%= (profile.permissions_count.to_f / profile.total_permissions_count * 100).round %>%; height: 100%; background: <%= profile.color %>;"></div>
                </div>
                <span style="font-size: 0.8rem; font-weight: 600; color: var(--slate-600);">
                  <%= profile.permissions_count %> / <%= profile.total_permissions_count %>
                </span>
              </div>
            </td>
            <td>
              <% if profile.is_default? %>
                <span class="badge badge-success">Sí</span>
              <% else %>
                <span style="color: var(--slate-400); font-size: 0.85rem;">—</span>
              <% end %>
            </td>
            <td>
              <div style="display: flex; gap: 0.35rem;">
                <%= link_to "Ver Matriz", profile_path(profile), class: "btn btn-secondary btn-sm" %>
                <%= link_to "Editar", edit_profile_path(profile), class: "btn btn-secondary btn-sm" %>
                <% unless profile.users.any? %>
                  <%= button_to "Eliminar", profile_path(profile), method: :delete, data: { turbo_confirm: "¿Seguro que deseas eliminar este perfil?" }, class: "btn btn-secondary btn-sm", style: "color: var(--danger);" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
