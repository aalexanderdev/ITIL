<% content_for :title, "Editar Perfil: #{@profile.name} - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Editar Perfil: <%= @profile.name %></h1>
    <p class="page-subtitle">Modifica la matriz de permisos y atributos del perfil</p>
  </div>
  <div>
    <%= link_to "← Volver a Perfiles", profiles_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<%= render "form", profile: @profile %>
