<% content_for :title, "Configuración de HelpdeskChat - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Configuración de HelpdeskChat</h1>
    <p class="page-subtitle">Personaliza la apariencia, rendimiento en tiempo real, políticas de tickets y avisos de eventos ITIL</p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <%= link_to root_path, class: "btn btn-secondary btn-sm" do %>
      <span>← Volver al Dashboard</span>
    <% end %>
  </div>
</div>

<%= form_with model: @chat_setting, url: chat_settings_path, method: :patch, local: true do |f| %>
  <% if @chat_setting.errors.any? %>
    <div class="alert alert-alert" style="margin-bottom: 1.5rem;">
      <strong>Por favor corrige los siguientes inconvenientes:</strong>
      <ul style="margin-left: 1.25rem; margin-top: 0.5rem;">
        <% @chat_setting.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">

    <!-- 1. Apariencia Visual -->
    <div class="card">
      <div class="card-header" style="display: flex; align-items: center; gap: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
        <h2 class="card-title" style="font-size: 1.05rem;">Apariencia y Estilos</h2>
      </div>
      <div class="card-body">
        <div class="form-group">
          <%= f.label :launcher_color, "Color de Botón Flotante (Launcher)", class: "form-label" %>
          <div style="display: flex; gap: 10px; align-items: center;">
            <%= f.color_field :launcher_color, id: "chat_setting_launcher_color", style: "width: 44px; height: 38px; border: 1px solid var(--slate-300); border-radius: var(--radius-sm); cursor: pointer; padding: 2px;" %>
            <input type="text" id="launcher_color_hex" class="form-control" style="max-width: 120px; font-family: monospace;" value="<%= @chat_setting.launcher_color %>" oninput="document.getElementById('chat_setting_launcher_color').value = this.value">
          </div>
          <small style="color: var(--slate-500); font-size: 0.775rem;">Color de fondo del lanzador circular en la esquina inferior derecha.</small>
        </div>

        <div class="form-group">
          <%= f.label :bubble_color, "Color de Burbujas Propias", class: "form-label" %>
          <div style="display: flex; gap: 10px; align-items: center;">
            <%= f.color_field :bubble_color, id: "chat_setting_bubble_color", style: "width: 44px; height: 38px; border: 1px solid var(--slate-300); border-radius: var(--radius-sm); cursor: pointer; padding: 2px;" %>
            <input type="text" id="bubble_color_hex" class="form-control" style="max-width: 120px; font-family: monospace;" value="<%= @chat_setting.bubble_color %>" oninput="document.getElementById('chat_setting_bubble_color').value = this.value">
          </div>
          <small style="color: var(--slate-500); font-size: 0.775rem;">Color de los mensajes enviados por el usuario actual.</small>
        </div>

        <div class="form-group">
          <%= f.label :mention_color, "Color de Menciones (@)", class: "form-label" %>
          <div style="display: flex; gap: 10px; align-items: center;">
            <%= f.color_field :mention_color, id: "chat_setting_mention_color", style: "width: 44px; height: 38px; border: 1px solid var(--slate-300); border-radius: var(--radius-sm); cursor: pointer; padding: 2px;" %>
            <input type="text" id="mention_color_hex" class="form-control" style="max-width: 120px; font-family: monospace;" value="<%= @chat_setting.mention_color %>" oninput="document.getElementById('chat_setting_mention_color').value = this.value">
          </div>
          <small style="color: var(--slate-500); font-size: 0.775rem;">Color resaltado para menciones a usuarios.</small>
        </div>

        <div class="form-row">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :panel_width_px, "Ancho del Panel (px)", class: "form-label" %>
            <%= f.number_field :panel_width_px, min: 320, max: 420, step: 5, class: "form-control" %>
            <small style="color: var(--slate-500); font-size: 0.75rem;">Rango: 320px - 420px (estándar: 380px)</small>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <%= f.label :font_size, "Tamaño de Fuente (px)", class: "form-label", style: "margin-bottom: 0;" %>
              <span id="font_size_badge" class="badge badge-primary"><%= @chat_setting.font_size %>px</span>
            </div>
            <%= f.range_field :font_size, min: 11, max: 20, step: 1, class: "form-control", style: "margin-top: 6px; padding: 0;", oninput: "document.getElementById('font_size_badge').textContent = this.value + 'px'; document.getElementById('preview_sample_text').style.fontSize = this.value + 'px';" %>
            <small style="color: var(--slate-500); font-size: 0.75rem;">Rango: 11px - 20px (estándar: 14px)</small>
          </div>
        </div>

        <div style="margin-top: 1rem; padding: 0.75rem 1rem; background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 0.8rem; color: var(--slate-500); font-weight: 600;">Vista previa de texto:</span>
          <span id="preview_sample_text" style="font-size: <%= @chat_setting.font_size %>px; font-weight: 500; color: var(--slate-800); transition: font-size 0.15s ease;">
            Hola! Este es un mensaje de prueba en el chat.
          </span>
        </div>
      </div>
    </div>

    <!-- 2. Colaboración e Interacciones en Vivo -->
    <div class="card">
      <div class="card-header" style="display: flex; align-items: center; gap: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--emerald-600)" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h2 class="card-title" style="font-size: 1.05rem;">Colaboración y Presencia</h2>
      </div>
      <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
          <%= f.check_box :presence_enabled, style: "margin-top: 4px; width: 18px; height: 18px;" %>
          <div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--slate-800); display: block;">Mostrar estado en línea (Presencia)</span>
            <span style="font-size: 0.8rem; color: var(--slate-500);">Emite latidos de actividad (heartbeat) y muestra qué usuarios están conectados en tiempo real.</span>
          </div>
        </label>

        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
          <%= f.check_box :typing_indicator_enabled, style: "margin-top: 4px; width: 18px; height: 18px;" %>
          <div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--slate-800); display: block;">Indicador de "Escribiendo..."</span>
            <span style="font-size: 0.8rem; color: var(--slate-500);">Informa en la conversación activa cuando el interlocutor está redactando una respuesta.</span>
          </div>
        </label>

        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
          <%= f.check_box :read_receipts_enabled, style: "margin-top: 4px; width: 18px; height: 18px;" %>
          <div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--slate-800); display: block;">Confirmaciones de Lectura (Doble Check)</span>
            <span style="font-size: 0.8rem; color: var(--slate-500);">Muestra ✓ para enviado, ✓✓ gris para entregado y ✓✓ azul para leído.</span>
          </div>
        </label>

        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
          <%= f.check_box :reactions_enabled, style: "margin-top: 4px; width: 18px; height: 18px;" %>
          <div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--slate-800); display: block;">Reacciones a Mensajes</span>
            <span style="font-size: 0.8rem; color: var(--slate-500);">Permite reaccionar con 👍 y emojis interactivos a cualquier mensaje de la conversación.</span>
          </div>
        </label>

        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
          <%= f.check_box :notification_sound_enabled, style: "margin-top: 4px; width: 18px; height: 18px;" %>
          <div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--slate-800); display: block;">Alertas y Notificaciones Sonoras</span>
            <span style="font-size: 0.8rem; color: var(--slate-500);">Reproduce tonos suaves de audio ante mensajes nuevos o menciones directas recibidas.</span>
          </div>
        </label>
      </div>
    </div>

    <!-- 3. Rendimiento y Polling -->
    <div class="card">
      <div class="card-header" style="display: flex; align-items: center; gap: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--amber-600)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <h2 class="card-title" style="font-size: 1.05rem;">Rendimiento y Polling (ms)</h2>
      </div>
      <div class="card-body">
        <div class="form-row">
          <div class="form-group">
            <%= f.label :poll_messages_ms, "Refresco de Mensajes (ms)", class: "form-label" %>
            <%= f.number_field :poll_messages_ms, min: 1000, max: 10000, step: 500, class: "form-control" %>
            <small style="color: var(--slate-500); font-size: 0.75rem;">En hilo abierto (1000 - 10000 ms, estándar: 2000 ms)</small>
          </div>

          <div class="form-group">
            <%= f.label :poll_conversations_ms, "Lista de Conversaciones (ms)", class: "form-label" %>
            <%= f.number_field :poll_conversations_ms, min: 3000, max: 30000, step: 1000, class: "form-control" %>
            <small style="color: var(--slate-500); font-size: 0.75rem;">Lista y no leídos (3000 - 30000 ms)</small>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <%= f.label :poll_presence_ms, "Heartbeat de Presencia (ms)", class: "form-label" %>
            <%= f.number_field :poll_presence_ms, min: 5000, max: 60000, step: 5000, class: "form-control" %>
            <small style="color: var(--slate-500); font-size: 0.75rem;">Envío de latido activo del usuario conectado</small>
          </div>

          <div class="form-group">
            <%= f.label :poll_online_users_ms, "Consulta Usuarios en Línea (ms)", class: "form-label" %>
            <%= f.number_field :poll_online_users_ms, min: 5000, max: 60000, step: 5000, class: "form-control" %>
            <small style="color: var(--slate-500); font-size: 0.75rem;">Actualización de bolitas verdes de contactos</small>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :max_message_length, "Longitud Máxima de Mensaje (caracteres)", class: "form-label" %>
          <%= f.number_field :max_message_length, min: 200, max: 5000, step: 100, class: "form-control" %>
          <small style="color: var(--slate-500); font-size: 0.75rem;">Límite de caracteres por mensaje (200 - 5000)</small>
        </div>
      </div>
    </div>

    <!-- 4. Conversión de Mensajes en Tickets -->
    <div class="card">
      <div class="card-header" style="display: flex; align-items: center; gap: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue-600)" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
        <h2 class="card-title" style="font-size: 1.05rem;">Conversión en Tickets (ITSM)</h2>
      </div>
      <div class="card-body">
        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; margin-bottom: 1rem;">
          <%= f.check_box :ticket_conversion_enabled, style: "margin-top: 4px; width: 18px; height: 18px;" %>
          <div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--slate-800); display: block;">Habilitar conversión de mensajes en Tickets</span>
            <span style="font-size: 0.8rem; color: var(--slate-500);">Permite al personal técnico convertir cualquier mensaje del chat directamente en un ticket formal con título y descripción precargados.</span>
          </div>
        </label>

        <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1rem;">
          <div style="font-weight: 600; font-size: 0.85rem; color: var(--slate-700); margin-bottom: 0.5rem;">Disponibilidad de la acción:</div>
          <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--slate-700); cursor: pointer;">
              <%= f.check_box :ticket_conversion_on_received %>
              <span>Permitir en mensajes recibidos de otros usuarios</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--slate-700); cursor: pointer;">
              <%= f.check_box :ticket_conversion_on_sent %>
              <span>Permitir en mensajes propios enviados</span>
            </label>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :ticket_conversion_requester, "Solicitante Asignado al Ticket Creado", class: "form-label" %>
            <%= f.select :ticket_conversion_requester, [["El usuario que realiza la conversión (técnico)", "converter"], ["El autor original del mensaje de chat", "author"]], {}, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Avisos Automáticos del Ciclo de Vida ITIL -->
    <div class="card" style="grid-column: 1 / -1;">
      <div class="card-header" style="display: flex; align-items: center; gap: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <h2 class="card-title" style="font-size: 1.05rem;">Avisos Automáticos en el Chat (Eventos del Ciclo de Vida ITIL)</h2>
      </div>
      <div class="card-body">
        <p style="font-size: 0.85rem; color: var(--slate-600); margin-bottom: 1rem;">
          Publica automáticamente un mensaje con enlace directo al ticket en el hilo personal de "Notificaciones del Sistema" del usuario correspondiente ante eventos clave:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
          <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1rem;">
            <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
              <%= f.check_box :notify_on_assignment, style: "margin-top: 3px; width: 16px; height: 16px;" %>
              <div>
                <span style="font-weight: 600; font-size: 0.875rem; color: var(--slate-800); display: block;">Asignación de Tickets</span>
                <span style="font-size: 0.775rem; color: var(--slate-500);">Avisa al técnico inmediatamente cuando se le asigna un ticket nuevo o transferido.</span>
              </div>
            </label>
          </div>

          <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1rem;">
            <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
              <%= f.check_box :notify_on_solution, style: "margin-top: 3px; width: 16px; height: 16px;" %>
              <div>
                <span style="font-weight: 600; font-size: 0.875rem; color: var(--slate-800); display: block;">Resolución y Cierre</span>
                <span style="font-size: 0.775rem; color: var(--slate-500);">Avisa al solicitante cuando su ticket es marcado como resuelto o formalmente cerrado.</span>
              </div>
            </label>
          </div>

          <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1rem;">
            <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
              <%= f.check_box :notify_on_comment, style: "margin-top: 3px; width: 16px; height: 16px;" %>
              <div>
                <span style="font-weight: 600; font-size: 0.875rem; color: var(--slate-800); display: block;">Seguimientos y Comentarios</span>
                <span style="font-size: 0.775rem; color: var(--slate-500);">Notifica al técnico o al usuario cuando la contraparte escribe una respuesta en el ticket.</span>
              </div>
            </label>
          </div>

          <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1rem;">
            <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
              <%= f.check_box :notify_on_private_note, style: "margin-top: 3px; width: 16px; height: 16px;" %>
              <div>
                <span style="font-weight: 600; font-size: 0.875rem; color: var(--slate-800); display: block;">Notas Técnicas Privadas</span>
                <span style="font-size: 0.775rem; color: var(--slate-500);">Avisa exclusivamente al técnico asignado cuando otro técnico agrega una nota interna.</span>
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 1rem; align-items: center; border-top: 1px solid var(--slate-200); padding-top: 1.5rem;">
    <%= link_to "Cancelar", root_path, class: "btn btn-secondary" %>
    <%= f.submit "Guardar Configuración de Chat", class: "btn btn-primary", style: "padding: 0.75rem 1.5rem; font-weight: 600;" %>
  </div>
<% end %>

<script>
  // Link color inputs with text boxes for instant preview
  document.getElementById('chat_setting_launcher_color').addEventListener('input', function() {
    document.getElementById('launcher_color_hex').value = this.value;
  });
  document.getElementById('chat_setting_bubble_color').addEventListener('input', function() {
    document.getElementById('bubble_color_hex').value = this.value;
  });
  document.getElementById('chat_setting_mention_color').addEventListener('input', function() {
    document.getElementById('mention_color_hex').value = this.value;
  });
</script>
