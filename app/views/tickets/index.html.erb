<% content_for :title, "Tickets e Incidencias - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Gestión de Tickets e Incidencias</h1>
    <p class="page-subtitle">Mesa de ayuda y seguimiento de servicios según ITIL</p>
  </div>
  <div>
    <%= link_to new_ticket_path, class: "btn btn-primary" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Crear Ticket</span>
    <% end %>
  </div>
</div>

<!-- Filters Bar -->
<div class="card" style="margin-bottom: 1.5rem;">
  <div class="card-body" style="padding: 1rem 1.25rem;">
    <%= form_with url: tickets_path, method: :get, local: true, style: "display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;" do |f| %>
      <div style="flex: 1; min-width: 200px;">
        <%= f.text_field :query, value: params[:query], placeholder: "Buscar por número, título o descripción...", class: "form-control" %>
      </div>

      <div style="width: 170px;">
        <%= f.select :status, options_for_select([["Todos los estados", ""]] + Ticket::STATUSES.invert.to_a, params[:status]), {}, class: "form-control", onchange: "this.form.submit()" %>
      </div>

      <div style="width: 170px;">
        <%= f.select :priority, options_for_select([["Todas las prioridades", ""]] + Ticket::PRIORITIES.invert.to_a, params[:priority]), {}, class: "form-control", onchange: "this.form.submit()" %>
      </div>

      <div style="width: 170px;">
        <%= f.select :ticket_type, options_for_select([["Todos los tipos", ""]] + Ticket::TICKET_TYPES.invert.to_a, params[:ticket_type]), {}, class: "form-control", onchange: "this.form.submit()" %>
      </div>

      <div>
        <%= f.submit "Filtrar", class: "btn btn-secondary btn-sm" %>
        <%= link_to "Limpiar", tickets_path, class: "btn btn-secondary btn-sm", style: "border: none; color: var(--slate-500);" if params.values.any?(&:present?) %>
      </div>
    <% end %>
  </div>
</div>

<!-- Tickets Table -->
<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Número</th>
          <th>Tipo</th>
          <th>Título</th>
          <th>Categoría</th>
          <th>Estado</th>
          <th>Prioridad</th>
          <th>Solicitante</th>
          <th>Técnico Asignado</th>
          <th>Vence (SLA)</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @tickets.any? %>
          <% @tickets.each do |ticket| %>
            <tr>
              <td>
                <%= link_to ticket.ticket_number, ticket_path(ticket), style: "font-weight: 700; color: var(--primary);" %>
              </td>
              <td>
                <span style="font-size: 0.8rem; font-weight: 600; color: var(--slate-600);">
                  <%= ticket.ticket_type == 'incident' ? '⚠️ Incidencia' : '📋 Solicitud' %>
                </span>
              </td>
              <td style="max-width: 260px;">
                <%= link_to ticket.title, ticket_path(ticket), style: "font-weight: 600; color: var(--slate-900);" %>
                <% if ticket.asset %>
                  <div style="font-size: 0.75rem; color: var(--slate-500);">
                    Activo: <strong><%= ticket.asset.asset_tag %></strong> (<%= ticket.asset.name %>)
                  </div>
                <% end %>
              </td>
              <td>
                <span style="font-size: 0.8rem; color: var(--slate-600);"><%= ticket.ticket_category&.name || "—" %></span>
              </td>
              <td>
                <span class="badge <%= ticket.status_badge_class %>">
                  <span class="badge-dot"></span>
                  <%= ticket.status_name %>
                </span>
              </td>
              <td>
                <span class="badge <%= ticket.priority_badge_class %>">
                  <%= ticket.priority_name %>
                </span>
              </td>
              <td>
                <div style="font-size: 0.85rem; font-weight: 500;"><%= ticket.requester&.full_name %></div>
                <div style="font-size: 0.725rem; color: var(--slate-400);"><%= ticket.requester&.department&.name %></div>
              </td>
              <td>
                <% if ticket.assigned_to %>
                  <span style="font-weight: 500; font-size: 0.85rem;"><%= ticket.assigned_to.full_name %></span>
                <% else %>
                  <span style="color: var(--slate-400); font-style: italic; font-size: 0.8rem;">Sin asignar</span>
                <% end %>
              </td>
              <td>
                <% if ticket.due_at %>
                  <span style="<%= 'color: #dc2626; font-weight: 700;' if ticket.overdue? %> font-size: 0.8rem;">
                    <%= ticket.due_at.strftime("%d/%m/%Y %H:%M") %>
                    <% if ticket.overdue? %>
                      <span title="Plazo SLA vencido">🚨</span>
                    <% end %>
                  </span>
                <% else %>
                  <span style="color: var(--slate-400);">—</span>
                <% end %>
              </td>
              <td>
                <%= link_to "Detalle", ticket_path(ticket), class: "btn btn-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="10" style="text-align: center; padding: 3rem; color: var(--slate-500);">
              No se encontraron tickets con los filtros seleccionados.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
