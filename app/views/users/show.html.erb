<% content_for :title, "#{@user.full_name} - Perfil de Usuario" %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= @user.full_name %></h1>
    <p class="page-subtitle"><%= @user.email_address %> • <%= @user.role.titleize %></p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <%= link_to "✏️ Editar Usuario", edit_user_path(@user), class: "btn btn-secondary btn-sm" %>
    <%= link_to "← Volver a Usuarios", users_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; align-items: start;">
  <!-- User Details -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Datos del Usuario</h2>
    </div>
    <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <span style="font-size: 0.75rem; color: var(--slate-400); text-transform: uppercase; font-weight: 700;">Rol</span>
        <div style="margin-top: 2px;">
          <span class="badge <%= @user.admin? ? 'badge-primary' : 'badge-secondary' %>"><%= @user.role.titleize %></span>
        </div>
      </div>

      <div>
        <span style="font-size: 0.75rem; color: var(--slate-400); text-transform: uppercase; font-weight: 700;">Departamento</span>
        <div style="font-weight: 600; color: var(--slate-900); margin-top: 2px;">
          <%= @user.department&.name || "Sin departamento asignado" %>
        </div>
      </div>

      <div>
        <span style="font-size: 0.75rem; color: var(--slate-400); text-transform: uppercase; font-weight: 700;">Teléfono</span>
        <div style="font-weight: 600; color: var(--slate-900); margin-top: 2px;">
          <%= @user.phone || "No registrado" %>
        </div>
      </div>

      <div>
        <span style="font-size: 0.75rem; color: var(--slate-400); text-transform: uppercase; font-weight: 700;">Activos Asignados</span>
        <div style="font-weight: 700; color: var(--primary); font-size: 1.1rem; margin-top: 2px;">
          💻 <%= @assets.count %> equipos en custodia
        </div>
      </div>
    </div>
  </div>

  <!-- Related Data: Assets & Tickets -->
  <div>
    <!-- Assets In Custody -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Equipos Asignados</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Etiqueta</th>
              <th>Equipo</th>
              <th>Tipo</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            <% if @assets.any? %>
              <% @assets.each do |asset| %>
                <tr>
                  <td><%= link_to asset.asset_tag, asset_path(asset), style: "font-weight: 700; color: var(--primary);" %></td>
                  <td><%= asset.name %> (<%= asset.model %>)</td>
                  <td><%= asset.type_name %></td>
                  <td><code><%= asset.ip_address || '—' %></code></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" style="text-align: center; padding: 1.5rem; color: var(--slate-500);">
                  No tiene activos asignados actualmente.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Requested Tickets -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Últimos Tickets Solicitados</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Número</th>
              <th>Título</th>
              <th>Estado</th>
              <th>Prioridad</th>
            </tr>
          </thead>
          <tbody>
            <% if @requested_tickets.any? %>
              <% @requested_tickets.each do |ticket| %>
                <tr>
                  <td><%= link_to ticket.ticket_number, ticket_path(ticket), style: "font-weight: 700; color: var(--primary);" %></td>
                  <td><%= link_to ticket.title, ticket_path(ticket), style: "font-weight: 500; color: var(--slate-900);" %></td>
                  <td><span class="badge <%= ticket.status_badge_class %>"><%= ticket.status_name %></span></td>
                  <td><span class="badge <%= ticket.priority_badge_class %>"><%= ticket.priority_name %></span></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" style="text-align: center; padding: 1.5rem; color: var(--slate-500);">
                  No ha generado tickets de soporte.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
