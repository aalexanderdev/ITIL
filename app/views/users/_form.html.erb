<%= form_with model: user, local: true do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-alert">
      <strong>Por favor corrige los siguientes errores:</strong>
      <ul style="margin-left: 1.25rem; margin-top: 0.5rem;">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Datos del Usuario</h2>
    </div>
    <div class="card-body">
      <div class="form-row">
        <div class="form-group">
          <%= f.label :first_name, "Nombre(s)", class: "form-label" %>
          <%= f.text_field :first_name, required: true, placeholder: "Ej. Juan", class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :last_name, "Apellido(s)", class: "form-label" %>
          <%= f.text_field :last_name, required: true, placeholder: "Ej. Pérez", class: "form-control" %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :email_address, "Correo Electrónico (Login)", class: "form-label" %>
          <%= f.email_field :email_address, required: true, placeholder: "usuario@itil.local", class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :password, user.new_record? ? "Contraseña *" : "Nueva Contraseña (dejar en blanco para conservar)", class: "form-label" %>
          <%= f.password_field :password, required: user.new_record?, placeholder: "••••••••", class: "form-control" %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :role, "Rol en el Sistema *", class: "form-label" %>
          <%= f.select :role, [["Usuario Final (Autoservicio)", "user"], ["Técnico de Soporte TI", "technician"], ["Administrador Global", "admin"]], {}, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :profile_id, "Perfil de Permisos (RBAC)", class: "form-label" %>
          <%= f.collection_select :profile_id, Profile.all, :id, :name, { prompt: "Predeterminado según rol" }, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :department_id, "Departamento", class: "form-label" %>
          <%= f.collection_select :department_id, Department.all, :id, :name, { prompt: "Seleccionar departamento..." }, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :phone, "Teléfono / Extensión", class: "form-label" %>
          <%= f.text_field :phone, placeholder: "+1 555-0199", class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 500; font-size: 0.875rem;">
          <%= f.check_box :active %>
          <span>Usuario activo (puede iniciar sesión en el sistema)</span>
        </label>
      </div>

      <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
        <%= f.submit user.new_record? ? "Crear Usuario" : "Guardar Cambios", class: "btn btn-primary" %>
        <%= link_to "Cancelar", users_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
<% end %>
