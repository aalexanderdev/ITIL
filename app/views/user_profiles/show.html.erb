<% content_for :title, "Mi Perfil - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Mi Perfil</h1>
    <p class="page-subtitle">Información de tu cuenta, perfil de permisos y equipos a tu cargo</p>
  </div>
  <div>
    <%= link_to edit_user_profile_path, class: "btn btn-primary" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      <span>Editar Datos y Contraseña</span>
    <% end %>
  </div>
</div>

<div style="display: grid; grid-template-columns: 320px 1fr; gap: 1.5rem; margin-bottom: 2rem;">
  <!-- Tarjeta de Identificación -->
  <div class="card">
    <div class="card-body" style="text-align: center; padding: 2rem 1.5rem;">
      <div style="width: 76px; height: 76px; border-radius: 50%; background: var(--primary, #4f46e5); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 1.85rem; font-weight: 700; margin-bottom: 1rem; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);">
        <%= @user.first_name&.first || @user.email_address.first.upcase %>
      </div>

      <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 0.25rem;">
        <%= @user.full_name %>
      </h2>
      <p style="font-size: 0.85rem; color: var(--slate-500); margin-bottom: 1rem;">
        <%= @user.email_address %>
      </p>

      <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <span class="badge badge-primary">
          <%= @user.role.titleize %>
        </span>
        <% if @user.effective_profile %>
          <span class="badge badge-light" style="display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--slate-200);">
            <span style="width: 8px; height: 8px; border-radius: 50%; background-color: <%= @user.effective_profile.color %>;"></span>
            <%= @user.effective_profile.name %>
          </span>
        <% end %>
      </div>

      <div style="border-top: 1px solid var(--slate-100); padding-top: 1.25rem; text-align: left; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem;">
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--slate-500);">Departamento:</span>
          <span style="font-weight: 600; color: var(--slate-800);"><%= @user.department&.name || "Sin asignar" %></span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--slate-500);">Teléfono / Extensión:</span>
          <span style="font-weight: 600; color: var(--slate-800);"><%= @user.phone.presence || "—" %></span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--slate-500);">Estado de Presencia:</span>
          <span class="badge <%= @user.online? ? 'badge-success' : 'badge-secondary' %>">
            <%= @user.online? ? "En línea" : "Desconectado" %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenido Central: Activos a Cargo y Tickets Recientes -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Equipos a Cargo -->
    <div class="card">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="card-title" style="font-size: 1rem;">Equipos y Activos a mi Cargo</h3>
        <span class="badge badge-light"><%= @assets.count %> asignado(s)</span>
      </div>
      <div class="card-body">
        <% if @assets.empty? %>
          <p style="font-size: 0.85rem; color: var(--slate-500); margin: 0;">No tienes activos de hardware asignados en custodia actualmente.</p>
        <% else %>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem;">
            <% @assets.each do |asset| %>
              <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1rem;">
                <div style="font-size: 0.75rem; color: var(--slate-500); font-weight: 600;"><%= asset.asset_type_name %></div>
                <div style="font-weight: 700; color: var(--slate-900); font-size: 0.95rem; margin-top: 2px;"><%= asset.name %></div>
                <div style="font-size: 0.8rem; color: var(--slate-600); margin-top: 4px;"><%= asset.manufacturer %> <%= asset.model %></div>
                <div style="margin-top: 0.5rem; font-family: monospace; font-size: 0.75rem; color: var(--primary); font-weight: 600;"><%= asset.asset_tag %></div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tickets Recientes Solicitados -->
    <div class="card">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="card-title" style="font-size: 1rem;">Mis Solicitudes e Incidencias Recientes</h3>
        <%= link_to "Ver todos mis tickets", tickets_path, class: "btn btn-secondary btn-sm" %>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if @requested_tickets.empty? %>
          <p style="font-size: 0.85rem; color: var(--slate-500); padding: 1.5rem; margin: 0;">No has reportado ningún ticket aún.</p>
        <% else %>
          <table class="table" style="margin-bottom: 0;">
            <thead>
              <tr>
                <th>Código</th>
                <th>Asunto</th>
                <th>Estado</th>
                <th>Prioridad</th>
                <th>Fecha</th>
              </tr>
            </thead>
            <tbody>
              <% @requested_tickets.each do |ticket| %>
                <tr>
                  <td><%= link_to ticket.ticket_number, ticket_path(ticket), style: "font-weight: 700; color: var(--primary);" %></td>
                  <td style="font-weight: 600;"><%= link_to ticket.title.truncate(45), ticket_path(ticket) %></td>
                  <td><span class="badge <%= ticket.status_badge_class %>"><%= ticket.status.titleize %></span></td>
                  <td><span class="badge <%= ticket.priority_badge_class %>"><%= ticket.priority_name %></span></td>
                  <td style="font-size: 0.8rem; color: var(--slate-500);"><%= l ticket.created_at, format: :short %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  </div>
</div>
