<% content_for :title, "Editar Mi Perfil - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Editar Mi Perfil</h1>
    <p class="page-subtitle">Actualiza tus datos de contacto o cambia tu contraseña de acceso</p>
  </div>
  <div>
    <%= link_to "← Volver a Mi Perfil", user_profile_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
  <!-- Card 1: Datos de Cuenta -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title" style="font-size: 1.05rem;">Información Personal y Contacto</h2>
    </div>
    <div class="card-body">
      <%= form_with model: @user, url: user_profile_path, method: :patch, local: true do |f| %>
        <% if @user.errors.any? %>
          <div class="alert alert-alert" style="margin-bottom: 1rem;">
            <ul style="margin-left: 1.25rem;">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-row">
          <div class="form-group">
            <%= f.label :first_name, "Nombre(s) *", class: "form-label" %>
            <%= f.text_field :first_name, required: true, class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :last_name, "Apellido(s) *", class: "form-label" %>
            <%= f.text_field :last_name, required: true, class: "form-control" %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :email_address, "Correo Electrónico (Login) *", class: "form-label" %>
          <%= f.email_field :email_address, required: true, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :phone, "Teléfono o Extensión", class: "form-label" %>
          <%= f.text_field :phone, placeholder: "+1 555-0100", class: "form-control" %>
        </div>

        <div style="margin-top: 1.5rem; border-top: 1px solid var(--slate-100); padding-top: 1rem;">
          <%= f.submit "Guardar Datos Personales", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Card 2: Cambio de Contraseña -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title" style="font-size: 1.05rem;">Seguridad y Cambio de Contraseña</h2>
    </div>
    <div class="card-body">
      <%= form_with url: update_password_user_profile_path, method: :patch, local: true do |f| %>
        <p style="font-size: 0.825rem; color: var(--slate-600); margin-bottom: 1.25rem;">
          Por seguridad, debes ingresar tu contraseña actual para establecer una nueva clave.
        </p>

        <div class="form-group">
          <label class="form-label" for="current_password">Contraseña Actual *</label>
          <input type="password" name="current_password" id="current_password" required="required" placeholder="••••••••" class="form-control">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Nueva Contraseña *</label>
          <input type="password" name="password" id="password" required="required" placeholder="Mínimo 8 caracteres" class="form-control">
        </div>

        <div class="form-group">
          <label class="form-label" for="password_confirmation">Confirmar Nueva Contraseña *</label>
          <input type="password" name="password_confirmation" id="password_confirmation" required="required" placeholder="Repite la nueva contraseña" class="form-control">
        </div>

        <div style="margin-top: 1.5rem; border-top: 1px solid var(--slate-100); padding-top: 1rem;">
          <button type="submit" class="btn btn-primary">Actualizar Contraseña</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
