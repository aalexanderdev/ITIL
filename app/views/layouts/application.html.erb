<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "OpenITIL - Gestión de Servicios y Activos TI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="OpenITIL">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="app-container">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar">
          <div class="sidebar-header">
            <div class="brand-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
              </svg>
            </div>
            <div>
              <span class="brand-text">OpenITIL</span>
              <span class="brand-tag">ITSM</span>
            </div>
          </div>

          <nav class="sidebar-nav">
            <div class="nav-section-title">Principal</div>
            
            <%= link_to root_path, class: "nav-item #{'active' if current_page?(root_path)}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              <span>Panel de Control</span>
            <% end %>

            <div class="nav-section-title">Helpdesk / Servicios</div>

            <%= link_to tickets_path, class: "nav-item #{'active' if controller_name == 'tickets'}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M15 5H9a2 2 0 0 0-2 2v14l5-3 5 3V7a2 2 0 0 0-2-2Z"/><path d="M10 2h4"/></svg>
              <span>Tickets e Incidencias</span>
              <% open_count = Ticket.open_tickets.count %>
              <% if open_count > 0 %>
                <span class="nav-badge"><%= open_count %></span>
              <% end %>
            <% end %>

            <%= link_to new_ticket_path, class: "nav-item" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
              <span>Crear Ticket</span>
            <% end %>

            <div class="nav-section-title">Inventario / CMDB</div>

            <%= link_to assets_path, class: "nav-item #{'active' if controller_name == 'assets'}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
              <span>Activos de TI</span>
              <span class="nav-badge"><%= Asset.count %></span>
            <% end %>

            <div class="nav-section-title">Conocimiento</div>

            <%= link_to kb_articles_path, class: "nav-item #{'active' if controller_name == 'kb_articles'}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
              <span>Base de Conocimiento</span>
            <% end %>

            <% if current_user&.admin? %>
              <div class="nav-section-title">Administración</div>

              <%= link_to users_path, class: "nav-item #{'active' if controller_name == 'users'}" do %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Usuarios y Roles</span>
              <% end %>

              <%= link_to departments_path, class: "nav-item #{'active' if controller_name == 'departments'}" do %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                <span>Departamentos y Sedes</span>
              <% end %>
            <% end %>
          </nav>

          <div class="sidebar-footer">
            <div class="user-avatar">
              <%= current_user.first_name&.first || current_user.email_address.first.upcase %>
            </div>
            <div class="user-info">
              <div class="user-name"><%= current_user.full_name %></div>
              <div class="user-role"><%= current_user.role.titleize %></div>
            </div>
            <%= button_to session_path, method: :delete, class: "btn-secondary btn-sm", style: "border:none; background: transparent; color: #94a3b8; padding: 4px;" do %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            <% end %>
          </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="app-main">
          <header class="app-header">
            <div class="header-search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--slate-400)" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <input type="text" placeholder="Buscar tickets, activos, números de serie...">
            </div>

            <div class="header-actions">
              <%= link_to new_ticket_path, class: "btn btn-primary btn-sm" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Nuevo Ticket</span>
              <% end %>

              <div style="font-size: 0.85rem; color: var(--slate-600); font-weight: 500; display: flex; align-items: center; gap: 6px;">
                <span class="badge badge-primary"><%= current_user.role.upcase %></span>
              </div>
            </div>
          </header>

          <main class="content-wrapper">
            <!-- Flash Messages -->
            <% if notice.present? %>
              <div class="alert alert-notice">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                <span><%= notice %></span>
              </div>
            <% end %>

            <% if alert.present? %>
              <div class="alert alert-alert">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                <span><%= alert %></span>
              </div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <!-- Unauthenticated Layout (e.g. Login) -->
      <div class="auth-page">
        <div class="auth-card">
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
