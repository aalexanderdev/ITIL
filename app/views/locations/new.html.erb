<% content_for :title, "Sede / Ubicación - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= @location.new_record? ? "Nueva Sede / Ubicación" : "Editar Sede / Ubicación" %></h1>
  </div>
  <div>
    <%= link_to "← Volver", departments_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div class="card" style="max-width: 600px;">
  <div class="card-body">
    <%= form_with model: @location, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "Nombre de la Sede *", class: "form-label" %>
        <%= f.text_field :name, required: true, placeholder: "Ej. Sede Central", class: "form-control" %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :building, "Edificio", class: "form-label" %>
          <%= f.text_field :building, placeholder: "Torre A", class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :floor, "Piso / Nivel", class: "form-label" %>
          <%= f.text_field :floor, placeholder: "Piso 4", class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :room, "Sala / Oficina", class: "form-label" %>
          <%= f.text_field :room, placeholder: "402 - TI", class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :description, "Descripción o Dirección", class: "form-label" %>
        <%= f.text_area :description, rows: 3, class: "form-control" %>
      </div>

      <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
        <%= f.submit @location.new_record? ? "Crear Sede" : "Guardar Cambios", class: "btn btn-primary" %>
        <%= link_to "Cancelar", departments_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
