<% vh = VisualhubSetting.current %>
<div class="auth-header">
  <div style="display: inline-flex; width: 48px; height: 48px; background: linear-gradient(135deg, var(--vh-primary, #4f46e5), var(--vh-accent, #06b6d4)); border-radius: 12px; align-items: center; justify-content: center; color: #fff; box-shadow: 0 8px 16px rgba(79,70,229,0.35);">
    <%= render_brand_logo(vh, size: 26) %>
  </div>
  <h2 class="auth-title"><%= vh.login_title %></h2>
  <p class="auth-subtitle"><%= vh.app_subtitle %></p>
</div>

<% if flash[:alert] %>
  <div class="alert alert-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<% if flash[:notice] %>
  <div class="alert alert-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<%= form_with url: session_path do |form| %>
  <div class="form-group">
    <%= form.label :email_address, "Correo Electrónico", class: "form-label" %>
    <%= form.email_field :email_address, id: "email_address_input", required: true, autofocus: true, autocomplete: "username", placeholder: "ejemplo@itil.local", value: params[:email_address] || "admin@itil.local", class: "form-control" %>
  </div>

  <div class="form-group">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
      <%= form.label :password, "Contraseña", class: "form-label", style: "margin-bottom: 0;" %>
      <%= link_to "¿Olvidaste tu contraseña?", new_password_path, style: "font-size: 0.775rem;" %>
    </div>
    <%= form.password_field :password, id: "password_input", required: true, autocomplete: "current-password", placeholder: "••••••••", value: "password123", class: "form-control" %>
  </div>

  <div style="margin-top: 1.5rem;">
    <%= form.submit "Ingresar al Sistema", class: "btn btn-primary", style: "width: 100%; padding: 0.75rem;" %>
  </div>
<% end %>

<div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--slate-200); text-align: center;">
  <p style="font-size: 0.8rem; color: var(--slate-500); margin-bottom: 0.6rem; font-weight: 600;">Accesos rápidos para demostración:</p>
  <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('email_address_input').value='admin@itil.local'; document.getElementById('password_input').value='password123';">
      👑 Administrador
    </button>
    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('email_address_input').value='tecnico@itil.local'; document.getElementById('password_input').value='password123';">
      🔧 Técnico TI
    </button>
    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('email_address_input').value='usuario@itil.local'; document.getElementById('password_input').value='password123';">
      👤 Usuario
    </button>
  </div>
</div>
