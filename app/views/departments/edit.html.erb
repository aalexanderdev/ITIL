<% content_for :title, "Editar Departamento - OpenITIL" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Editar Departamento</h1>
    <p class="page-subtitle"><%= @department.name %></p>
  </div>
  <div>
    <%= link_to "← Volver", departments_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div class="card" style="max-width: 600px;">
  <div class="card-body">
    <%= form_with model: @department, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "Nombre del Departamento *", class: "form-label" %>
        <%= f.text_field :name, required: true, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :code, "Código Interno", class: "form-label" %>
        <%= f.text_field :code, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :location_id, "Sede Principal", class: "form-label" %>
        <%= f.collection_select :location_id, Location.all, :id, :name, { prompt: "Seleccionar sede..." }, class: "form-control" %>
      </div>

      <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
        <%= f.submit "Guardar Cambios", class: "btn btn-primary" %>
        <%= link_to "Cancelar", departments_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
